<mxfile host="app.diagrams.net">
  <diagram id="fig1" name="Figura 1 - Dilema de calibração">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Entrada -->
        <mxCell id="pedido" value="&lt;b&gt;Pedido do usuário&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Análise -->
        <mxCell id="analise" value="&lt;b&gt;Análise&lt;/b&gt;&lt;br&gt;intenção · risco · fontes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F5F5F5;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="350" y="105" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- Resultados -->
        <mxCell id="falha" value="&lt;b&gt;Falha de proteção&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pedido prejudicial recebe&lt;br&gt;resposta com conteúdo inadequado&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="calibrada" value="&lt;b&gt;Resposta calibrada&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Atende ao propósito educativo&lt;br&gt;com segurança e base nas fontes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#D5E8D4;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="390" y="230" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="recusa" value="&lt;b&gt;Recusa indevida&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pergunta educativa legítima&lt;br&gt;recebe recusa desnecessária&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="230" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Setas análise -> resultados -->
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="pedido" target="analise">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="permissivo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analise" target="falha">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="calibrado" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analise" target="calibrada">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="restritivo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analise" target="recusa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dimensões -->
        <mxCell id="seguranca" value="Segurança" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="105" y="380" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="grupo" value="&lt;b&gt;Qualidade da resposta&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="355" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="correcao" value="Correção factual" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="310" y="380" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sustentacao" value="Sustentação nas fontes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="440" y="380" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="clareza" value="Clareza" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="570" y="380" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="atendimento" value="Atendimento" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="765" y="380" width="130" height="40" as="geometry" />
        </mxCell>

        <!-- Ligações resultados -> dimensões -->
        <mxCell id="d1" value="medida por" style="html=1;endArrow=open;dashed=1;strokeColor=#555555;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="falha" target="seguranca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="medida por" style="html=1;endArrow=open;dashed=1;strokeColor=#555555;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="calibrada" target="grupo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="medida por" style="html=1;endArrow=open;dashed=1;strokeColor=#555555;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="recusa" target="atendimento">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Eixo de calibração -->
        <mxCell id="eixo" value="" style="html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="470" as="sourcePoint" />
            <mxPoint x="940" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zona" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="463" width="120" height="14" as="geometry" />
        </mxCell>
        <mxCell id="lblEsq" value="&lt;b&gt;Permissivo demais&lt;/b&gt;&lt;br&gt;&lt;i&gt;(subproteção)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="482" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lblCentro" value="&lt;b&gt;Zona de calibração&lt;/b&gt;&lt;br&gt;&lt;i&gt;(comportamento pretendido)&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="482" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lblDir" value="&lt;b&gt;Restritivo demais&lt;/b&gt;&lt;br&gt;&lt;i&gt;(superproteção)&lt;/i&gt;" style="text;html=1;align=right;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="482" width="200" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
