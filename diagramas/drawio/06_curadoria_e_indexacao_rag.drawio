<mxCell id="source" value="&lt;b&gt;Fontes e manifesto&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 recortes de Ciências&lt;br&gt;3 sínteses experimentais" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="25" y="60" width="385" height="92" as="geometry"/></mxCell>
