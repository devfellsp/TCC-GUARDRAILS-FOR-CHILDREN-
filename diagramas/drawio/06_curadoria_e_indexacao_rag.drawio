<mxfile host="app.diagrams.net" modified="2026-11-03T16:35:00.000Z" agent="GuardKids-TCC" version="24.0.0" type="device">
  <diagram id="diag_6" name="Fig 6 - Curadoria e Indexacao RAG">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_banner" value="Figura 6 — Processo de curadoria documental, recorte por âncoras e indexação vetorial do acervo do 4º ano" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#1A365D;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1040" height="35" as="geometry" /></mxCell>
        <mxCell id="pdf1" value="Fonte Pública 1: Trilhas de Aprendizagens — 4º ano, v. 2, 2. ed.&lt;br&gt;Secretaria Municipal de Educação de São Paulo (São Paulo, 2021)&lt;br&gt;Licença aberta (CC BY-NC-SA 4.0) — Ciências: Cadeias Alimentares" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="450" height="80" as="geometry" /></mxCell>
        <mxCell id="pdf2" value="Fonte Pública 2: Currículo em Ação — Livro do Estudante (4º ano, v. 2)&lt;br&gt;Secretaria da Educação do Estado de São Paulo (São Paulo, 2024)&lt;br&gt;2º Bimestre — Ciências: Alimentação dos Seres Vivos e Decompositores" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="450" height="80" as="geometry" /></mxCell>
        <mxCell id="curadoria" value="Conferência Pedagógica e Recorte Auditável (poc/corpus_manifest.json)&lt;br&gt;Seleção de textos explicativos autocontidos (compreensíveis sem imagens/vídeos)&lt;br&gt;Delimitação exata por âncoras textuais (start_anchor, end_anchor e exclude_From_anchor)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="185" width="700" height="80" as="geometry" /></mxCell>
        <mxCell id="excl" value="Conteúdos Explicitamente Excluídos na Curadoria&lt;br&gt;• p. 153 (Trilhas, 2021): texto curto dependente de vídeos externos&lt;br&gt;• p. 12 (SEDUC-SP, 2024): mistura cadeia alimentar e ecossistema&lt;br&gt;• p. 22 (SEDUC-SP, 2024): formulação imprecisa sobre fluxo não&lt;br&gt;  unidirecional e &#x27;produção&#x27; de energia pelos seres vivos&lt;br&gt;• Exercícios de lacunas, V ou F, legendas de figuras e QR codes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="305" width="440" height="165" as="geometry" /></mxCell>
        <mxCell id="aprov" value="5 Páginas Aprovadas e Extraídas via pypdf (5 Chunks)&lt;br&gt;• trilhas2021-p154-1 (p. 154): produtores, esquilo e falcão (predação)&lt;br&gt;• sp2024-p8-1 (p. 8): nutrientes, energia e alimentação dos seres vivos&lt;br&gt;• sp2024-p9-1 (p. 9): animais onívoros e produtores (fotossíntese)&lt;br&gt;• sp2024-p13-1 (p. 13): consumidores (herbívoros/carnívoros) e decompositores&lt;br&gt;• sp2024-p27-1 (p. 27): reciclagem da matéria orgânica por fungos/bactérias" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="305" width="510" height="165" as="geometry" /></mxCell>
        <mxCell id="idx" value="Segmentação e Indexação Vetorial Densa (guardkids.py index — 6,87 s)&lt;br&gt;• Divisão até 850 caracteres com sobreposição de 1 sentença (sentence_overlap=1)&lt;br&gt;• Geração de embeddings em CPU com bge-m3:latest (1.024 dimensões, norma L2)&lt;br&gt;• Persistência auditável em poc/data/chunks.json e poc/data/index.npz (SHA-256)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="515" width="510" height="105" as="geometry" /></mxCell>
        <mxCell id="e6_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.3;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pdf1" target="curadoria">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.7;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pdf2" target="curadoria">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6_3" value="Descartados" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="curadoria" target="excl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6_4" value="Aprovados" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2d6a4f;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="curadoria" target="aprov">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6_5" value="Vetorização" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2d6a4f;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="aprov" target="idx">
