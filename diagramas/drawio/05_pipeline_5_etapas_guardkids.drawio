<mxCell id="persist" value="&lt;b&gt;Persistir antes de exibir qualquer mensagem&lt;/b&gt;&lt;br&gt;&lt;br&gt;Falha de gravação retém a resposta. Rascunhos rejeitados não são enviados à interface." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="920" height="70" as="geometry"/></mxCell>
