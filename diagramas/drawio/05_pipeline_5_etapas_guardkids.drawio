<mxCell id="in" value="&lt;b&gt;1  Entrada&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dados pessoais&lt;br&gt;Intenção e risco" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="178" height="160" as="geometry"/></mxCell>
