<mxfile host="app.diagrams.net" modified="2026-11-03T16:35:00.000Z" agent="GuardKids-TCC" version="24.0.0" type="device">
  <diagram id="diag_3" name="Fig 3 - Arquitetura Conceitual">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_banner" value="Figura 3 — Arquitetura conceitual de guardrails integrados ao RAG e ao controle de perfil e hiperparâmetros" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#1A365D;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1040" height="35" as="geometry" /></mxCell>
        <mxCell id="c1" value="CAMADA 1 — Proteção por Padrão e Privacidade Infantil (Wang et al., 2022)&lt;br&gt;• Operação desacoplada de coleta de dados pessoais (superando os 85% de tutores que perfilam crianças)&lt;br&gt;• Perfil etário/escolar fixo e não identificável (9 anos / 4º ano EF) + Regra determinística anti-exposição de PII" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="65" width="980" height="110" as="geometry" /></mxCell>
        <mxCell id="c2" value="CAMADA 2 — Guardrails Configuráveis de Entrada e Saída (Rath et al., 2025; Khoo, Chua e Shong, 2025; Brasil, 2025)&lt;br&gt;• Políticas declaradas em arquivo de configuração externo (config.json) separado da lógica da aplicação&lt;br&gt;• Verificação de turno único na Entrada (antes do RAG) e na Saída (inspeção do rascunho antes da entrega à criança)&lt;br&gt;• Cobertura das categorias: Perigo, Autolesão, Sexual, Ofensas/Ódio, Substâncias, Privacidade e Prompt Injection" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="980" height="125" as="geometry" /></mxCell>
        <mxCell id="c3" value="CAMADA 3 — Memória Não Paramétrica e Guardrail de Escopo Curricular via RAG (Lewis et al., 2020)&lt;br&gt;• Índice vetorial denso (BGE-M3) construído exclusivamente com trechos revisados de apostilas públicas do 4º ano&lt;br&gt;• Guardrail de suficiência documental (limiar de similaridade cosseno &gt;= 0,45 e validação estrita de source_ids)&lt;br&gt;• Redirecionamento educativo para perguntas fora do tema Seres Vivos, contendo alucinações paramétricas" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="980" height="125" as="geometry" /></mxCell>
        <mxCell id="c4" value="CAMADA 4 — Controle de Perfil Sociolinguístico e Hiperparâmetros de Inferência (Martínez et al., 2024)&lt;br&gt;• Papel sociolinguístico infantil (child role) instruindo frases curtas, vocabulário simples e explicação de termos científicos&lt;br&gt;• Estabilidade experimental pela fixação de hiperparâmetros (temperature = 0, seed = 42, top_p = 0,9, repeat_penalty = 1,1)&lt;br&gt;• Isolamento rigoroso do efeito das configurações de guardrails sobre T_RI, T_BI e clareza lexical" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="980" height="120" as="geometry" /></mxCell>
        <mxCell id="e3_1" value="Fronteira de Privacidade" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_2" value="Pergunta Permitida pelos Guardrails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.35;exitY=1.0;exitDx=0;exitDy=0;entryX=0.35;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_3" value="Contexto Curricular Recuperado (Top-K)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_4" value="Rascunho Gerado p/ Guardrail de Saída" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.85;exitY=0.0;exitDx=0;exitDy=0;entryX=0.85;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c2">
