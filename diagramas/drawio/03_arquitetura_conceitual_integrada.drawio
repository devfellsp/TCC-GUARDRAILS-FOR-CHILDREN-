<mxCell id="request" value="&lt;b&gt;Contexto da tentativa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pergunta + chat  |  Perfil fictício de 9 anos  |  Regra comum  |  Direto ou Passo a passo" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="900" height="72" as="geometry"/></mxCell>
<mxCell id="input" value="&lt;b&gt;1  Proteção de entrada&lt;/b&gt;&lt;br&gt;&lt;br&gt;Detector parcial de dados&lt;br&gt;Classificação de intenção&lt;br&gt;Intervenção tem precedência" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="15" y="55" width="260" height="160" as="geometry"/></mxCell>
<mxCell id="retrieve" value="&lt;b&gt;2  Recuperação no chat&lt;/b&gt;&lt;br&gt;&lt;br&gt;Índice validado: 8 trechos&lt;br&gt;Embeddings com BGE-M3&lt;br&gt;Até 3 trechos; limiar 0,45" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="335" y="55" width="260" height="160" as="geometry"/></mxCell>
<mxCell id="generate" value="&lt;b&gt;3  Geração com fontes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Qwen3:8b + estilo escolhido&lt;br&gt;Resposta estruturada&lt;br&gt;Limite de 120 palavras" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#edf6f2;strokeColor=#367260;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="655" y="55" width="260" height="160" as="geometry"/></mxCell>
<mxCell id="ground" value="&lt;b&gt;4  Apoio documental&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conferir IDs e extensão&lt;br&gt;Detector parcial de dados&lt;br&gt;Verificação de sustentação" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f3eff8;strokeColor=#78628f;strokeWidth=1.8;" vertex="1" parent="group1"><mxGeometry x="655" y="55" width="260" height="160" as="geometry"/></mxCell>
<mxCell id="output" value="&lt;b&gt;5  Proteção de saída&lt;/b&gt;&lt;br&gt;&lt;br&gt;Classificar o texto gerado&lt;br&gt;Aplicar a regra comum&lt;br&gt;Reter rascunho reprovado" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="group1"><mxGeometry x="335" y="55" width="260" height="160" as="geometry"/></mxCell>
<mxCell id="record" value="&lt;b&gt;6  Registro da tentativa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Persistência antes da saída&lt;br&gt;Comum: texto minimizado&lt;br&gt;Fictício: registro integral" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="group1"><mxGeometry x="15" y="55" width="260" height="160" as="geometry"/></mxCell>
<mxCell id="answer" value="&lt;b&gt;Mensagem exibida&lt;/b&gt;&lt;br&gt;&lt;br&gt;Explicação com fontes, cuidado, recusa ou aviso de apoio insuficiente" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#edf6f2;strokeColor=#367260;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="900" height="66" as="geometry"/></mxCell>
<mxCell id="note0" value="Caminho completo: até quatro chamadas ao mesmo Qwen3. Intervenções podem encerrar antes." style="text;html=1;align=center;fontSize=17;fontColor=#536574;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="960" height="30" as="geometry"/></mxCell>
