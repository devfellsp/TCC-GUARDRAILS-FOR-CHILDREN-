        <mxCell id="title_banner" value="Figura 1 — O dilema de calibração de guardrails em chatbots educativos infantis (Segurança vs. Utilidade)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#1A365D;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1040" height="35" as="geometry" /></mxCell>
        <mxCell id="in_q" value="Solicitação do Estudante (7 a 11 anos | Perfil Fictício: 9 anos / 4º ano)&lt;br&gt;Dúvidas de Ciências (Seres Vivos), Casos Ambíguos (Predação) ou Solicitações de Risco" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1A365D;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="310" y="65" width="480" height="65" as="geometry" /></mxCell>
        <mxCell id="g_perm" value="1. Política Excessivamente Permissiva" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdf2f2;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=8 8;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="310" height="410" as="geometry" /></mxCell>
        <mxCell id="p_mech" value="Sem Guardrails Dedicados à Infância&lt;br&gt;(Apenas alinhamento nativo adulto do LLM)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="65" y="225" width="260" height="75" as="geometry" /></mxCell>
        <mxCell id="p_eff" value="Falha em solicitações nocivas infantis&lt;br&gt;e alucinações fora do currículo escolar&lt;br&gt;(Rath et al., 2025; Khoo et al., 2025)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="65" y="335" width="260" height="85" as="geometry" /></mxCell>
        <mxCell id="p_ind" value="Efeito nos Indicadores:&lt;br&gt;• Taxa de Respostas Inadequadas ALTA (T_RI ↑)&lt;br&gt;• Criança exposta a conteúdos impróprios&lt;br&gt;(51% a 64% de falha em LLMs gerais)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="65" y="455" width="260" height="105" as="geometry" /></mxCell>
        <mxCell id="g_rest" value="2. Política Excessivamente Restritiva" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffdf0;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=8 8;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="395" y="180" width="310" height="410" as="geometry" /></mxCell>
        <mxCell id="r_mech" value="Filtro Rígido Descontextualizado&lt;br&gt;(Bloqueio por palavras sensíveis: &#x27;morte&#x27;, &#x27;comer&#x27;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="225" width="260" height="75" as="geometry" /></mxCell>
        <mxCell id="r_eff" value="Rejeita dúvidas legítimas de Ciências&lt;br&gt;sobre predação na cadeia alimentar&lt;br&gt;(Ex.: &#x27;Por que o falcão come o esquilo?&#x27;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="335" width="260" height="85" as="geometry" /></mxCell>
        <mxCell id="r_ind" value="Efeito nos Indicadores:&lt;br&gt;• Taxa de Bloqueios Indevidos ALTA (T_BI ↑)&lt;br&gt;• Alto Custo de Segurança (Safety Cost)&lt;br&gt;• Prejuízo à utilidade pedagógica" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="455" width="260" height="105" as="geometry" /></mxCell>
        <mxCell id="g_ctx" value="3. Guardrails Contextuais Configuráveis (GuardKids)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f9f0;strokeColor=#82b366;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=8 8;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="750" y="180" width="310" height="410" as="geometry" /></mxCell>
        <mxCell id="c_mech" value="Guardrails de Entrada/Saída + RAG&lt;br&gt;Pondera Risco Real vs. Contexto Educativo&lt;br&gt;(Classificação Indicativa — Brasil, 2025)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="775" y="225" width="260" height="75" as="geometry" /></mxCell>
        <mxCell id="c_eff" value="Bloqueia instruções de dano (needs_protection)&lt;br&gt;e permite predação ecológica ancorada&lt;br&gt;na apostila do 4º ano (ajuste pontual)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="775" y="335" width="260" height="85" as="geometry" /></mxCell>
        <mxCell id="c_ind" value="Equilíbrio Alvo no TCC:&lt;br&gt;• Respostas Inadequadas Minimizadas (T_RI = 0%)&lt;br&gt;• Bloqueios Indevidos Eliminados (T_BI ↓)&lt;br&gt;• Respostas corretas, pertinentes e claras" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="775" y="455" width="260" height="105" as="geometry" /></mxCell>
