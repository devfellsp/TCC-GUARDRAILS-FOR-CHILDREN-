<mxCell id="subtitle" value="O problema de pesquisa: a mesma palavra pode aparecer em intenções diferentes." style="text;html=1;align=center;fontSize=17;fontColor=#536574;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="960" height="42" as="geometry"/></mxCell>
