<mxCell id="h1" value="&lt;b&gt;Piloto de outubro&lt;/b&gt;&lt;br&gt;&lt;br&gt;22 execuções preservadas&lt;br&gt;Condições anteriores" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="15" y="70" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="h2" value="&lt;b&gt;Dois lotes de Ciências&lt;/b&gt;&lt;br&gt;&lt;br&gt;108 execuções no total&lt;br&gt;27 perguntas reutilizadas" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="15" y="215" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="h3" value="&lt;b&gt;Uso das evidências&lt;/b&gt;&lt;br&gt;&lt;br&gt;Descrever falhas e versões&lt;br&gt;Sem integrar o lote atual" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="15" y="360" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="d1" value="&lt;b&gt;Regra comum + estilos&lt;/b&gt;&lt;br&gt;&lt;br&gt;16 perguntas conhecidas&lt;br&gt;32 tentativas executadas" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="group1"><mxGeometry x="15" y="70" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="d2" value="&lt;b&gt;Inspeção assistida por IA&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 de 8 explicações com&lt;br&gt;ressalvas de sustentação" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="group1"><mxGeometry x="15" y="215" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="d3" value="&lt;b&gt;Limite da interpretação&lt;/b&gt;&lt;br&gt;&lt;br&gt;Campos humanos vazios&lt;br&gt;Sem eficácia demonstrada" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="group1"><mxGeometry x="15" y="360" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="f1" value="&lt;b&gt;Reserva operacional&lt;/b&gt;&lt;br&gt;&lt;br&gt;32 perguntas / 16 famílias&lt;br&gt;64 tentativas planejadas" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#edf6f2;strokeColor=#367260;strokeWidth=1.8;" vertex="1" parent="group2"><mxGeometry x="15" y="70" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="f2" value="&lt;b&gt;Antes da execução&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ratificação humana&lt;br&gt;Congelamento da versão" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#edf6f2;strokeColor=#367260;strokeWidth=1.8;" vertex="1" parent="group2"><mxGeometry x="15" y="215" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="f3" value="&lt;b&gt;Depois da execução&lt;/b&gt;&lt;br&gt;&lt;br&gt;Revisão por dimensão&lt;br&gt;Comparação pareada" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#edf6f2;strokeColor=#367260;strokeWidth=1.8;" vertex="1" parent="group2"><mxGeometry x="15" y="360" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="fixed" value="&lt;b&gt;O que a comparação atual modifica?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Somente a instrução de linguagem. Perfil, regra, fontes e modelo permanecem iguais." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f3eff8;strokeColor=#78628f;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="50" y="680" width="900" height="66" as="geometry"/></mxCell>
<mxCell id="note0" value="A avaliação final não foi executada. A reserva é conhecida pelos autores e não é independente." style="text;html=1;align=center;fontSize=17;fontColor=#536574;" vertex="1" parent="1"><mxGeometry x="20" y="762" width="960" height="30" as="geometry"/></mxCell>
