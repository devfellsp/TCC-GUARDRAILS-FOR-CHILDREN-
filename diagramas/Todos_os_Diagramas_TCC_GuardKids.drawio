<mxCell id="open" value="&lt;b&gt;1  Permissividade&lt;/b&gt;&lt;br&gt;&lt;br&gt;Resposta fluente não basta.&lt;br&gt;Um pedido prejudicial pode&lt;br&gt;receber instruções de dano.&lt;br&gt;Risco: liberação inadequada." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#fbeeee;strokeColor=#a14b4b;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="280" height="230" as="geometry"/></mxCell>
<mxCell id="closed" value="&lt;b&gt;2  Restrição excessiva&lt;/b&gt;&lt;br&gt;&lt;br&gt;Palavra sensível não basta.&lt;br&gt;Uma dúvida escolar pode&lt;br&gt;ser recusada sem necessidade.&lt;br&gt;Risco: bloqueio indevido." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#fff6e8;strokeColor=#9c702e;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="280" height="230" as="geometry"/></mxCell>
<mxCell id="context" value="&lt;b&gt;3  Leitura contextual&lt;/b&gt;&lt;br&gt;&lt;br&gt;Examinar intenção e contexto.&lt;br&gt;Distinguir educação e risco.&lt;br&gt;Oferecer cuidado na ajuda.&lt;br&gt;Conferir apoio nas fontes." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#edf6f2;strokeColor=#367260;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="280" height="230" as="geometry"/></mxCell>
<mxCell id="question" value="&lt;b&gt;Avaliar dimensões separadas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Segurança  |  Tratamento  |  Correção  |  Sustentação  |  Clareza" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="110" y="445" width="780" height="95" as="geometry"/></mxCell>
<mxCell id="note0" value="Quadro conceitual. As três situações não são condições experimentais da POC atual." style="text;html=1;align=center;fontSize=17;fontColor=#536574;" vertex="1" parent="1"><mxGeometry x="20" y="575" width="960" height="30" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
