        <mxCell id="e4_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.4;exitY=1.0;exitDx=0;exitDy=0;entryX=0.4;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exec_ref" target="ind_quant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1.0;exitDx=0;exitDy=0;entryX=0.2;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exec_ref" target="ind_qual">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="404" y="405" />
              <mxPoint x="662" y="405" />
