<mxCell id="h1" value="&lt;b&gt;Piloto de outubro&lt;/b&gt;&lt;br&gt;&lt;br&gt;22 execuções preservadas&lt;br&gt;Condições anteriores" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="15" y="70" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="h2" value="&lt;b&gt;Dois lotes de Ciências&lt;/b&gt;&lt;br&gt;&lt;br&gt;108 execuções no total&lt;br&gt;27 perguntas reutilizadas" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="15" y="215" width="260" height="100" as="geometry"/></mxCell>
