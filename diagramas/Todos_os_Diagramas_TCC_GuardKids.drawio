  <diagram id="diag_5" name="Fig 5 - Pipeline 5 Etapas PoC">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_banner" value="Figura 5 — Pipeline sequencial de cinco etapas implementado no protótipo GuardKids (poc/guardkids_core/pipeline.py)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#1A365D;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1090" height="35" as="geometry" /></mxCell>
        <mxCell id="req" value="Entrada: Pergunta do Estudante + Configuração Ativa (referencia ou ajustada)&lt;br&gt;Endpoint POST /api/chat ou Executor em Lote (guardkids.py batch)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="65" width="520" height="50" as="geometry" /></mxCell>
        <mxCell id="s1" value="ETAPA 1 — Guardrail de Entrada (Input Guardrail)&lt;br&gt;• Regra determinística (Regex) para dados pessoais explícitos (nome, endereço, escola)&lt;br&gt;• Classificador contextual Qwen3 8B (Classification JSON: category, needs_protection, educational_predation)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="145" width="520" height="75" as="geometry" /></mxCell>
        <mxCell id="d1" value="Permitida&lt;br&gt;na Entrada?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;fontColor=#1a1a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="145" width="150" height="75" as="geometry" /></mxCell>
        <mxCell id="b_in" value="Bloqueio / Orientação na Entrada&lt;br&gt;(final_status = block)&lt;br&gt;Retorna mensagem da política" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="145" width="260" height="75" as="geometry" /></mxCell>
        <mxCell id="s2" value="ETAPA 2 — Recuperação Vetorial (RAG) e Guardrail de Escopo&lt;br&gt;• Embedding da pergunta via bge-m3:latest em CPU (vetor normalizado 1.024 dim)&lt;br&gt;• Busca por similaridade cosseno em data/index.npz (top_k = 3, limiar min_similarity = 0,45)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="255" width="520" height="75" as="geometry" /></mxCell>
        <mxCell id="d2" value="Similaridade&lt;br&gt;máx &gt;= 0,45?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;fontColor=#1a1a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="255" width="150" height="75" as="geometry" /></mxCell>
        <mxCell id="b_sc1" value="Fora do Escopo Curricular&lt;br&gt;(final_status = out_of_scope)&lt;br&gt;Redirecionamento educativo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="255" width="260" height="75" as="geometry" /></mxCell>
        <mxCell id="s3" value="ETAPA 3 — Geração Educativa Ancorada (Qwen3 8B)&lt;br&gt;• Contexto restrito aos trechos recuperados (tratados como dados, sem autoridade de comando)&lt;br&gt;• temp=0, seed=42, think=false → Generation JSON (supported, answer, source_ids)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="365" width="520" height="70" as="geometry" /></mxCell>
        <mxCell id="s4" value="ETAPA 4 — Guardrail de Sustentação e Integridade de Citação&lt;br&gt;• Verifica se supported == true, se answer não é vazia e se todos os source_ids&lt;br&gt;  citados pertencem exatamente ao subconjunto de trechos recuperados na Etapa 2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="520" height="70" as="geometry" /></mxCell>
        <mxCell id="d4" value="Sustentada e&lt;br&gt;IDs válidos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;fontColor=#1a1a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="462" width="150" height="75" as="geometry" /></mxCell>
        <mxCell id="b_sc2" value="Insuficiência / Citação Inválida&lt;br&gt;(final_status = out_of_scope)&lt;br&gt;Evita alucinação não ancorada" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="462" width="260" height="75" as="geometry" /></mxCell>
        <mxCell id="s5" value="ETAPA 5 — Guardrail de Saída (Output Guardrail)&lt;br&gt;• Nova inspeção contextual do rascunho answer pelo classificador Qwen3 8B&lt;br&gt;• Aplica a mesma política ativa (referencia ou ajustada) antes da exibição à criança" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="565" width="520" height="75" as="geometry" /></mxCell>
        <mxCell id="d5_ok" value="Saída&lt;br&gt;Segura?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;fontColor=#1a1a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="565" width="150" height="75" as="geometry" /></mxCell>
        <mxCell id="b_out" value="Bloqueio na Saída (block)&lt;br&gt;Retém rascunho em rejected_response&lt;br&gt;(oculto na API) e exibe proteção" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="565" width="260" height="75" as="geometry" /></mxCell>
        <mxCell id="ok_final" value="Resposta Educativa Disponibilizada (final_status = allow)&lt;br&gt;Exibe explicação clara para 9 anos acompanhada das fontes citadas (source_ids)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a4f;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="665" width="520" height="55" as="geometry" /></mxCell>
        <mxCell id="log_box" value="Auditoria em logs/runs.jsonl (Todas as Execuções)&lt;br&gt;Grava decisões de entrada/saída, trechos, tempos e hashes SHA-256" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;strokeWidth=1.5;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="630" y="665" width="470" height="55" as="geometry" /></mxCell>
