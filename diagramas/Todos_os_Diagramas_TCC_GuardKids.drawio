<mxCell id="f3" value="&lt;b&gt;Depois da execução&lt;/b&gt;&lt;br&gt;&lt;br&gt;Revisão por dimensão&lt;br&gt;Comparação pareada" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#edf6f2;strokeColor=#367260;strokeWidth=1.8;" vertex="1" parent="group2"><mxGeometry x="15" y="360" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="fixed" value="&lt;b&gt;O que a comparação atual modifica?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Somente a instrução de linguagem. Perfil, regra, fontes e modelo permanecem iguais." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f3eff8;strokeColor=#78628f;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="50" y="680" width="900" height="66" as="geometry"/></mxCell>
