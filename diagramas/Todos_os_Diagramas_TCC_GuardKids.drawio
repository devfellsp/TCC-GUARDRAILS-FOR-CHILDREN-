<mxCell id="d2" value="&lt;b&gt;Inspeção assistida por IA&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 de 8 explicações com&lt;br&gt;ressalvas de sustentação" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="group1"><mxGeometry x="15" y="215" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="d3" value="&lt;b&gt;Limite da interpretação&lt;/b&gt;&lt;br&gt;&lt;br&gt;Campos humanos vazios&lt;br&gt;Sem eficácia demonstrada" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="group1"><mxGeometry x="15" y="360" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="f1" value="&lt;b&gt;Reserva operacional&lt;/b&gt;&lt;br&gt;&lt;br&gt;32 perguntas / 16 famílias&lt;br&gt;64 tentativas planejadas" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#edf6f2;strokeColor=#367260;strokeWidth=1.8;" vertex="1" parent="group2"><mxGeometry x="15" y="70" width="260" height="100" as="geometry"/></mxCell>
