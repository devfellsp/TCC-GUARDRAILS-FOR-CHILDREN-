<mxCell id="refs" value="&lt;b&gt;Categorias de cuidado&lt;/b&gt;&lt;br&gt;&lt;br&gt;Perigo e autolesão&lt;br&gt;Sexual e ofensas&lt;br&gt;Substâncias e privacidade&lt;br&gt;Injeção de instruções&lt;br&gt;Guia ClassInd e literatura" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#f4f5f6;strokeColor=#73808c;strokeWidth=1.8;" vertex="1" parent="group0"><mxGeometry x="20" y="75" width="245" height="270" as="geometry"/></mxCell>
<mxCell id="context" value="&lt;b&gt;Leitura da solicitação&lt;/b&gt;&lt;br&gt;&lt;br&gt;O que a pessoa pretende?&lt;br&gt;Pede dano ou pede ajuda?&lt;br&gt;É uma dúvida educativa?&lt;br&gt;Qual é o chat escolhido?&lt;br&gt;O acervo pode responder?" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#eef4fb;strokeColor=#426b95;strokeWidth=1.8;" vertex="1" parent="group1"><mxGeometry x="20" y="75" width="245" height="270" as="geometry"/></mxCell>
<mxCell id="care" value="&lt;b&gt;Intervir&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bloqueio ou cuidado fixo" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#fbeeee;strokeColor=#a14b4b;strokeWidth=1.8;" vertex="1" parent="group2"><mxGeometry x="20" y="60" width="250" height="95" as="geometry"/></mxCell>
<mxCell id="edu" value="&lt;b&gt;Prosseguir&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gerar e verificar a resposta" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#edf6f2;strokeColor=#367260;strokeWidth=1.8;" vertex="1" parent="group2"><mxGeometry x="20" y="190" width="250" height="95" as="geometry"/></mxCell>
<mxCell id="lack" value="&lt;b&gt;Comunicar limite&lt;/b&gt;&lt;br&gt;&lt;br&gt;Falta de apoio no acervo" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=18;fontColor=#20364a;fillColor=#fff6e8;strokeColor=#9c702e;strokeWidth=1.8;" vertex="1" parent="group2"><mxGeometry x="20" y="320" width="250" height="95" as="geometry"/></mxCell>
<mxCell id="note0" value="A referência classificatória não representa uma classificação oficial do chatbot." style="text;html=1;align=center;fontSize=17;fontColor=#536574;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="960" height="30" as="geometry"/></mxCell>
<mxCell id="note1" value="Perfil operacional: nove anos fictícios. A adequação à faixa de 7-11 anos não foi demonstrada." style="text;html=1;align=center;fontSize=17;fontColor=#536574;" vertex="1" parent="1"><mxGeometry x="20" y="654" width="960" height="30" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
